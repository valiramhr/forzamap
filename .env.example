# client (Vite) — safe to expose
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# edge function secrets (set with: supabase secrets set KEY=value) — NOT exposed
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are provided automatically
# RESEND_API_KEY=re_xxxxxxxx
# SITE_URL=https://your-app.vercel.app
# INVITE_FROM=Strengths Profile <noreply@yourdomain.com>
